      document.getElementById('exp1title').value = s.exp_1_title || '';
      document.getElementById('exp1desc').value = s.exp_1_desc || '';
      document.getElementById('exp2title').value = s.exp_2_title || '';
      document.getElementById('exp2desc').value = s.exp_2_desc || '';
      document.getElementById('exp3title').value = s.exp_3_title || '';
      document.getElementById('exp3desc').value = s.exp_3_desc || '';
      document.getElementById('exp4title').value = s.exp_4_title || '';
      document.getElementById('exp4desc').value = s.exp_4_desc || '';
    }
    loadExtraSettings();

    document.getElementById('saveStrip').addEventListener('click', async () => {
      await saveSetting('strip_1', document.getElementById('strip1').value);
      await saveSetting('strip_2', document.getElementById('strip2').value);
      await saveSetting('strip_3', document.getElementById('strip3').value);
      await saveSetting('strip_4', document.getElementById('strip4').value);
      document.getElementById('stripSaved').style.display = 'block';
      setTimeout(() => { document.getElementById('stripSaved').style.display = 'none'; }, 3000);
    });

    document.getElementById('saveIntroText').addEventListener('click', async () => {
      await saveSetting('intro_title', document.getElementById('introTitle').value);
      await saveSetting('intro_desc_1', document.getElementById('introDesc1').value);
      await saveSetting('intro_desc_2', document.getElementById('introDesc2').value);
      document.getElementById('introTextSaved').style.display = 'block';
      setTimeout(() => { document.getElementById('introTextSaved').style.display = 'none'; }, 3000);
    });

    document.getElementById('saveStats').addEventListener('click', async () => {
      await saveSetting('stat_1_number', document.getElementById('stat1num').value);
      await saveSetting('stat_1_label', document.getElementById('stat1label').value);
      await saveSetting('stat_2_number', document.getElementById('stat2num').value);
      await saveSetting('stat_2_label', document.getElementById('stat2label').value);
      await saveSetting('stat_3_number', document.getElementById('stat3num').value);
      await saveSetting('stat_3_label', document.getElementById('stat3label').value);
      await saveSetting('stat_4_number', document.getElementById('stat4num').value);
      await saveSetting('stat_4_label', document.getElementById('stat4label').value);
      document.getElementById('statsSaved').style.display = 'block';
      setTimeout(() => { document.getElementById('statsSaved').style.display = 'none'; }, 3000);
    });

    document.getElementById('saveExp').addEventListener('click', async () => {
      await saveSetting('exp_1_title', document.getElementById('exp1title').value);
      await saveSetting('exp_1_desc', document.getElementById('exp1desc').value);
      await saveSetting('exp_2_title', document.getElementById('exp2title').value);
      await saveSetting('exp_2_desc', document.getElementById('exp2desc').value);
      await saveSetting('exp_3_title', document.getElementById('exp3title').value);
      await saveSetting('exp_3_desc', document.getElementById('exp3desc').value);
      await saveSetting('exp_4_title', document.getElementById('exp4title').value);
      await saveSetting('exp_4_desc', document.getElementById('exp4desc').value);
      document.getElementById('expSaved').style.display = 'block';
      setTimeout(() => { document.getElementById('expSaved').style.display = 'none'; }, 3000);
    });

    // ── INTRO IMAGE ──
    document.getElementById('introUploadArea').addEventListener('click', () => document.getElementById('introImageUpload').click());
    document.getElementById('introImageUpload').addEventListener('change', async (e) => {
      const url = await uploadImage('site-images', 'intro', e.target.files[0]);
      if (!url) return;
      await saveSetting('intro_image', url);
      document.getElementById('introImagePreview').src = url;
      document.getElementById('introImagePreview').style.display = 'block';
      document.getElementById('introSaved').style.display = 'block';
      setTimeout(() => { document.getElementById('introSaved').style.display = 'none'; }, 3000);
    });

    // ── TESTIMONIAL ──
    document.getElementById('saveTestimonial').addEventListener('click', async () => {
      await saveSetting('testimonial_quote', document.getElementById('testimonialQuote').value);
      await saveSetting('testimonial_author', document.getElementById('testimonialAuthor').value);
      document.getElementById('testimonialSaved').style.display = 'block';
      setTimeout(() => { document.getElementById('testimonialSaved').style.display = 'none'; }, 3000);
    });

    // ── VILLA INFO ──
    const { data: villa } = await supabase.from('villa').select('*').single();
    if (villa) {
      document.getElementById('villaName').value = villa.name || '';
      document.getElementById('villaPrice').value = villa.price || '';
      document.getElementById('villaDesc').value = villa.description || '';
    }

    document.getElementById('saveVilla').addEventListener('click', async () => {
      const name = document.getElementById('villaName').value;
      const price = document.getElementById('villaPrice').value;
      const description = document.getElementById('villaDesc').value;
      const { data: villaData } = await supabase.from('villa').select('*').single();
      if (villaData) {
        await supabase.from('villa').update({ name, price, description }).eq('name', villaData.name);
      } else {
        await supabase.from('villa').insert({ name, price, description });
      }
      document.getElementById('villaSaved').style.display = 'block';
      setTimeout(() => { document.getElementById('villaSaved').style.display = 'none'; }, 3000);
    });

    // ── VILLA HERO IMAGE ──
    document.getElementById('villaHeroUpload').addEventListener('click', () => document.getElementById('villaHeroInput').click());
    document.getElementById('villaHeroInput').addEventListener('change', async (e) => {
      const url = await uploadImage('site-images', 'villa_hero', e.target.files[0]);
      if (!url) return;
      await saveSetting('villa_hero_image', url);
      document.getElementById('villaHeroPreview').src = url;
      document.getElementById('villaHeroPreview').style.display = 'block';
      document.getElementById('villaHeroSaved').style.display = 'block';
      setTimeout(() => { document.getElementById('villaHeroSaved').style.display = 'none'; }, 3000);
    });

    document.getElementById('saveVillaHero').addEventListener('click', async () => {
      document.getElementById('villaHeroSaved').style.display = 'block';
      setTimeout(() => { document.getElementById('villaHeroSaved').style.display = 'none'; }, 3000);
    });

    // ── VILLA MAIN IMAGE ──
    document.getElementById('villaMainUpload').addEventListener('click', () => document.getElementById('villaMainInput').click());
    document.getElementById('villaMainInput').addEventListener('change', async (e) => {
      const url = await uploadImage('site-images', 'villa_main', e.target.files[0]);
      if (!url) return;
      await saveSetting('villa_main_image', url);
      document.getElementById('villaMainPreview').src = url;
      document.getElementById('villaMainPreview').style.display = 'block';
      document.getElementById('villaMainSaved').style.display = 'block';
      setTimeout(() => { document.getElementById('villaMainSaved').style.display = 'none'; }, 3000);
    });

    document.getElementById('saveVillaMain').addEventListener('click', async () => {
      document.getElementById('villaMainSaved').style.display = 'block';
      setTimeout(() => { document.getElementById('villaMainSaved').style.display = 'none'; }, 3000);
    });

    // ── VILLA GALLERY ──
    let villaGalleryPhotos = [];

    function renderVillaGallery() {
      const grid = document.getElementById('villaGalleryGrid');
      if (villaGalleryPhotos.length === 0) {
        grid.innerHTML = '<p style="color:#6b7280; font-size:14px;">No photos yet.</p>';
        return;
      }
      grid.innerHTML = villaGalleryPhotos.map((url, i) => `
        <div class="villa-img-item">
          <img src="${url}" alt="Villa photo ${i+1}">
          <button onclick="removeVillaPhoto(${i})">✕</button>
        </div>
      `).join('');
    }

    window.removeVillaPhoto = (index) => {
      villaGalleryPhotos.splice(index, 1);
      renderVillaGallery();
    };

    document.getElementById('villaGalleryUpload').addEventListener('click', () => {
      if (villaGalleryPhotos.length >= 5) { alert('Maximum 5 photos allowed!'); return; }
      document.getElementById('villaGalleryInput').click();
    });

    document.getElementById('villaGalleryInput').addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;
      if (file.size > 5 * 1024 * 1024) { alert('File size must not exceed 5MB!'); return; }
      const url = await uploadImage('site-images', 'villa_gallery', file);
      if (!url) return;
      villaGalleryPhotos.push(url);
      renderVillaGallery();
      e.target.value = '';
    });

    document.getElementById('saveVillaGallery').addEventListener('click', async () => {
      await saveSetting('villa_gallery', JSON.stringify(villaGalleryPhotos));
      document.getElementById('villaGallerySaved').style.display = 'block';
      setTimeout(() => { document.getElementById('villaGallerySaved').style.display = 'none'; }, 3000);
    });

    // ── GALLERY HERO IMAGE ──
    document.getElementById('galleryHeroUpload').addEventListener('click', () => document.getElementById('galleryHeroInput').click());
    document.getElementById('galleryHeroInput').addEventListener('change', async (e) => {
      const url = await uploadImage('site-images', 'gallery_hero', e.target.files[0]);
      if (!url) return;
      await saveSetting('gallery_hero_image', url);
      document.getElementById('galleryHeroPreview').src = url;
      document.getElementById('galleryHeroPreview').style.display = 'block';
      document.getElementById('galleryHeroSaved').style.display = 'block';
      setTimeout(() => { document.getElementById('galleryHeroSaved').style.display = 'none'; }, 3000);
    });
    document.getElementById('saveGalleryHero').addEventListener('click', async () => {
      document.getElementById('galleryHeroSaved').style.display = 'block';
      setTimeout(() => { document.getElementById('galleryHeroSaved').style.display = 'none'; }, 3000);
    });

    // ── PUBLIC GALLERY ──
    async function loadGallery() {
      const { data } = await supabase.from('gallery').select('*');
      const grid = document.getElementById('galleryGrid');
      if (!data || data.length === 0) { grid.innerHTML = '<p style="color:#6b7280; font-size:14px;">No photos yet.</p>'; return; }
      grid.innerHTML = data.map(photo => `
        <div class="gallery-thumb">
          <img src="${photo.url}" alt="${photo.caption || ''}">
          <button class="gallery-thumb-delete" onclick="deletePhoto('${photo.id}', '${photo.url}')">✕</button>
        </div>
      `).join('');
    }

    loadGallery();

    document.getElementById('uploadArea').addEventListener('click', () => document.getElementById('photoUpload').click());
    document.getElementById('photoUpload').addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;
      if (!file.type.startsWith('image/')) { alert('Only image files are allowed!'); return; }
      if (file.size > 5 * 1024 * 1024) { alert('File size must not exceed 5MB!'); return; }
      const fileName = `${Date.now()}_${file.name}`;
      const { error: uploadError } = await supabase.storage.from('gallery').upload(fileName, file);
      if (uploadError) { alert('Upload failed: ' + uploadError.message); return; }
      const { data: urlData } = supabase.storage.from('gallery').getPublicUrl(fileName);
      const { error: dbError } = await supabase.from('gallery').insert({ url: urlData.publicUrl, caption: file.name, category: document.getElementById('photoCategory').value });
      if (!dbError) loadGallery();
    });

    window.deletePhoto = async (id, url) => {
      if (!confirm('Delete this photo?')) return;
      const fileName = url.split('/').pop();
      await supabase.storage.from('gallery').remove([fileName]);
      await supabase.from('gallery').delete().eq('id', id);
      loadGallery();
    };

    // ── CONTACT HERO IMAGE ──
    document.getElementById('contactHeroUpload').addEventListener('click', () => document.getElementById('contactHeroInput').click());
    document.getElementById('contactHeroInput').addEventListener('change', async (e) => {
      const url = await uploadImage('site-images', 'contact_hero', e.target.files[0]);
      if (!url) return;
      await saveSetting('contact_hero_image', url);
      document.getElementById('contactHeroPreview').src = url;
      document.getElementById('contactHeroPreview').style.display = 'block';
      document.getElementById('contactHeroSaved').style.display = 'block';
      setTimeout(() => { document.getElementById('contactHeroSaved').style.display = 'none'; }, 3000);
    });
    document.getElementById('saveContactHero').addEventListener('click', async () => {
      document.getElementById('contactHeroSaved').style.display = 'block';
      setTimeout(() => { document.getElementById('contactHeroSaved').style.display = 'none'; }, 3000);
    });

    // ── LOAD CONTACT SETTINGS ──
    async function loadContactSettings() {
      const { data } = await supabase.from('site_settings').select('*');
      if (!data) return;
      const settings = {};
      data.forEach(row => settings[row.key] = row.value);
      document.getElementById('contactFacebook').value = settings.contact_facebook || '';
      document.getElementById('contactPhone').value = settings.contact_phone || '';
      document.getElementById('contactPhoneLink').value = settings.contact_phone_link || '';
      document.getElementById('contactEmail').value = settings.contact_email || '';
      document.getElementById('contactHours').value = settings.contact_hours || '';
    }

    loadContactSettings();

    document.getElementById('saveContact').addEventListener('click', async () => {
      await saveSetting('contact_facebook', document.getElementById('contactFacebook').value);
      await saveSetting('contact_phone', document.getElementById('contactPhone').value);
      await saveSetting('contact_phone_link', document.getElementById('contactPhoneLink').value);
      await saveSetting('contact_email', document.getElementById('contactEmail').value);
      await saveSetting('contact_hours', document.getElementById('contactHours').value);
      document.getElementById('contactSaved').style.display = 'block';
      setTimeout(() => { document.getElementById('contactSaved').style.display = 'none'; }, 3000);
    });

    // ── EDITOR ──
    async function loadEditor() {
      const { data: editors } = await supabase.from('profiles').select('*').eq('role', 'editor');
      if (editors && editors.length > 0) {
        document.getElementById('editorStatus').innerHTML = `Current editor: <span>${editors[0].email}</span>`;
        document.getElementById('addEditorForm').style.display = 'none';
        document.getElementById('removeEditorForm').style.display = 'block';
      } else {
        document.getElementById('editorStatus').innerHTML = 'No editor assigned yet.';
        document.getElementById('addEditorForm').style.display = 'block';
        document.getElementById('removeEditorForm').style.display = 'none';
      }
    }

    loadEditor();

    document.getElementById('addEditor').addEventListener('click', async () => {
      const email = document.getElementById('editorEmail').value;
      const password = document.getElementById('editorPassword').value;
      if (!email || !password) { alert('Please enter both email and password!'); return; }
      if (password.length < 6) { alert('Password must be at least 6 characters!'); return; }
      const { data: existing } = await supabase.from('profiles').select('*').eq('role', 'editor');
      if (existing && existing.length > 0) { alert('An editor already exists! Remove the current editor first.'); return; }
      const { error: signUpError } = await supabase.auth.signUp({ email, password });
      if (signUpError) { alert('Error creating account: ' + signUpError.message); return; }
      const { error: profileError } = await supabase.from('profiles').insert({ email, role: 'editor' });
      if (!profileError) {
        document.getElementById('editorSaved').style.display = 'block';
        document.getElementById('editorEmail').value = '';
        document.getElementById('editorPassword').value = '';
        setTimeout(() => { document.getElementById('editorSaved').style.display = 'none'; }, 3000);
        loadEditor();
      }
    });

    document.getElementById('removeEditor').addEventListener('click', async () => {
      if (!confirm('Are you sure you want to remove the editor?')) return;
      const { data: editors } = await supabase.from('profiles').select('*').eq('role', 'editor');
      const editorEmail = editors[0].email;
      await fetch('/api/remove-editor', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: editorEmail }) });
      const { error } = await supabase.from('profiles').delete().eq('role', 'editor');
      if (!error) {
        document.getElementById('editorRemoved').style.display = 'block';
        setTimeout(() => { document.getElementById('editorRemoved').style.display = 'none'; }, 3000);
        loadEditor();
      }
    });

  </script>
</body>
</html>