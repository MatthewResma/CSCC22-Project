  <script type="module">
    import { createClient } from 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm';

    const supabaseUrl = 'https://nrvoscraeeeeheeoxrgp.supabase.co';
    const supabaseKey = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5ydm9zY3JhZWVlZWhlZW94cmdwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzc3MjYyNTksImV4cCI6MjA5MzMwMjI1OX0.ngNxR0TQPqouL-cOHfamqGzMIVvtCqNjTe9GYDLXAzA';
    const supabase = createClient(supabaseUrl, supabaseKey);

    const { data: { session } } = await supabase.auth.getSession();
    if (!session) { window.location.href = '/login'; }

    const { data: profile } = await supabase.from('profiles').select('role').eq('email', session.user.email).single();
    if (profile?.role !== 'owner') {
      document.querySelector('[data-section="editor"]').style.display = 'none';
    }

    document.querySelectorAll('.nav-item').forEach(item => {
      item.addEventListener('click', () => {
        document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
        document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
        item.classList.add('active');
        document.getElementById('section-' + item.dataset.section).classList.add('active');
      });
    });

    document.getElementById('logoutBtn').addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = '/login';
    });

    async function saveSetting(key, value) {
      const { data: existing } = await supabase.from('site_settings').select('key').eq('key', key).single();
      if (existing) {
        await supabase.from('site_settings').update({ value }).eq('key', key);
      } else {
        await supabase.from('site_settings').insert({ key, value });
      }
    }

    async function uploadImage(bucket, prefix, file) {
      const fileName = `${prefix}_${Date.now()}_${file.name}`;
      const { error } = await supabase.storage.from(bucket).upload(fileName, file);
      if (error) { alert('Upload failed: ' + error.message); return null; }
      const { data: urlData } = supabase.storage.from(bucket).getPublicUrl(fileName);
      return urlData.publicUrl;
    }

    // ── LOAD ALL SETTINGS ──
    async function loadSiteSettings() {
      const { data } = await supabase.from('site_settings').select('*');
      if (!data) return;
      const settings = {};
      data.forEach(row => settings[row.key] = row.value);

      document.getElementById('heroTitle').value = settings.hero_title || '';
      document.getElementById('heroSubtitle').value = settings.hero_subtitle || '';
      document.getElementById('testimonialQuote').value = settings.testimonial_quote || '';
      document.getElementById('testimonialAuthor').value = settings.testimonial_author || '';

      if (settings.hero_image) { document.getElementById('heroImagePreview').src = settings.hero_image; document.getElementById('heroImagePreview').style.display = 'block'; }
      if (settings.intro_image) { document.getElementById('introImagePreview').src = settings.intro_image; document.getElementById('introImagePreview').style.display = 'block'; }
      if (settings.villa_hero_image) { document.getElementById('villaHeroPreview').src = settings.villa_hero_image; document.getElementById('villaHeroPreview').style.display = 'block'; }
      if (settings.villa_main_image) { document.getElementById('villaMainPreview').src = settings.villa_main_image; document.getElementById('villaMainPreview').style.display = 'block'; }
      if (settings.villa_gallery) { villaGalleryPhotos = JSON.parse(settings.villa_gallery); renderVillaGallery(); }
      if (settings.gallery_hero_image) { document.getElementById('galleryHeroPreview').src = settings.gallery_hero_image; document.getElementById('galleryHeroPreview').style.display = 'block'; }
      if (settings.contact_hero_image) { document.getElementById('contactHeroPreview').src = settings.contact_hero_image; document.getElementById('contactHeroPreview').style.display = 'block'; }
    }

    loadSiteSettings();

    // ── HOMEPAGE HERO ──
    document.getElementById('heroUploadArea').addEventListener('click', () => document.getElementById('heroImageUpload').click());
    document.getElementById('heroImageUpload').addEventListener('change', async (e) => {
      const url = await uploadImage('site-images', 'hero', e.target.files[0]);
      if (!url) return;
      await saveSetting('hero_image', url);
      document.getElementById('heroImagePreview').src = url;
      document.getElementById('heroImagePreview').style.display = 'block';
    });

    document.getElementById('saveHero').addEventListener('click', async () => {
