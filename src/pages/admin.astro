---
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard | Lcabana Resort</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'DM Sans', sans-serif;
      background: #f5f7fb;
      color: #1a1a2e;
    }

    .sidebar {
      position: fixed;
      left: 0; top: 0;
      width: 240px;
      height: 100vh;
      background: #003049;
      padding: 32px 0;
      display: flex;
      flex-direction: column;
    }

    .sidebar-logo {
      font-family: 'Cormorant Garamond', serif;
      font-size: 26px;
      font-weight: 600;
      color: white;
      letter-spacing: 2px;
      padding: 0 28px;
      margin-bottom: 8px;
    }

    .sidebar-subtitle {
      font-size: 11px;
      color: rgba(255,255,255,0.4);
      letter-spacing: 1px;
      text-transform: uppercase;
      padding: 0 28px;
      margin-bottom: 40px;
    }

    .nav-item {
      padding: 14px 28px;
      color: rgba(255,255,255,0.6);
      font-size: 13px;
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      gap: 12px;
      border-left: 3px solid transparent;
    }

    .nav-item:hover, .nav-item.active {
      background: rgba(255,255,255,0.08);
      color: white;
      border-left-color: #c9a84c;
    }

    .sidebar-bottom {
      margin-top: auto;
      padding: 0 28px;
    }

    .btn-logout {
      width: 100%;
      padding: 12px;
      background: transparent;
      border: 1px solid rgba(255,255,255,0.2);
      color: rgba(255,255,255,0.6);
      font-family: 'DM Sans', sans-serif;
      font-size: 12px;
      letter-spacing: 1px;
      text-transform: uppercase;
      border-radius: 2px;
      cursor: pointer;
      transition: all 0.3s;
    }

    .btn-logout:hover { border-color: white; color: white; }

    .main {
      margin-left: 240px;
      padding: 40px;
      min-height: 100vh;
    }

    .page-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 36px;
      font-weight: 300;
      color: #003049;
      margin-bottom: 8px;
    }

    .page-subtitle {
      font-size: 13px;
      color: #6b7280;
      margin-bottom: 40px;
    }

    .section { display: none; }
    .section.active { display: block; }

    .card {
      background: white;
      border-radius: 6px;
      padding: 36px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.06);
      margin-bottom: 24px;
    }

    .card h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 24px;
      font-weight: 400;
      color: #003049;
      margin-bottom: 24px;
      padding-bottom: 16px;
      border-bottom: 1px solid #f0f0f0;
    }

    .form-group { margin-bottom: 20px; }

    .form-group label {
      display: block;
      font-size: 11px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #6b7280;
      margin-bottom: 8px;
    }

    .form-group input,
    .form-group textarea,
    .form-group select {
      width: 100%;
      padding: 12px 16px;
      border: 1px solid #e0e0e0;
      border-radius: 2px;
      font-family: 'DM Sans', sans-serif;
      font-size: 14px;
      color: #1a1a2e;
      outline: none;
      transition: border-color 0.3s;
      background: white;
    }

    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus { border-color: #c9a84c; }

    .form-group textarea { resize: vertical; min-height: 100px; }

    .btn-save {
      padding: 12px 32px;
      background: #003049;
      color: white;
      border: none;
      font-family: 'DM Sans', sans-serif;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 2px;
      text-transform: uppercase;
      border-radius: 2px;
      cursor: pointer;
      transition: background 0.3s;
    }

    .btn-save:hover { background: #0077b6; }

    .success-msg {
      display: none;
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      color: #166534;
      padding: 12px 16px;
      border-radius: 2px;
      font-size: 13px;
      margin-bottom: 20px;
    }

    #galleryGrid {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 24px;
    }

    .gallery-thumb {
      position: relative;
      border-radius: 4px;
      overflow: hidden;
      width: 120px;
      height: 120px;
      background: #f0f0f0;
      flex-shrink: 0;
    }

    .gallery-thumb img {
      width: 120px;
      height: 120px;
      object-fit: cover;
      display: block;
    }

    .gallery-thumb-delete {
      position: absolute;
      top: 6px;
      right: 6px;
      background: rgba(220,38,38,0.9);
      color: white;
      border: none;
      border-radius: 2px;
      width: 26px;
      height: 26px;
      cursor: pointer;
      font-size: 13px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .upload-area {
      border: 2px dashed #e0e0e0;
      border-radius: 4px;
      padding: 40px;
      text-align: center;
      cursor: pointer;
      transition: border-color 0.3s;
      margin-top: 16px;
    }

    .upload-area:hover { border-color: #c9a84c; }

    .upload-area p {
      color: #6b7280;
      font-size: 14px;
      margin-top: 8px;
    }

    .editor-status {
      padding: 16px 20px;
      background: #f5f7fb;
      border-radius: 4px;
      margin-bottom: 20px;
      font-size: 14px;
      color: #6b7280;
    }

    .editor-status span {
      color: #003049;
      font-weight: 500;
    }

    .btn-danger {
      padding: 12px 32px;
      background: #dc2626;
      color: white;
      border: none;
      font-family: 'DM Sans', sans-serif;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 2px;
      text-transform: uppercase;
      border-radius: 2px;
      cursor: pointer;
      transition: background 0.3s;
    }

    .btn-danger:hover { background: #b91c1c; }
  </style>
</head>
<body>

  <!-- SIDEBAR -->
  <div class="sidebar">
    <div class="sidebar-logo">Lcabana</div>
    <div class="sidebar-subtitle">Admin Panel</div>
    <div class="nav-item active" data-section="villa">🏡 Villa Info</div>
    <div class="nav-item" data-section="gallery">🖼️ Gallery</div>
    <div class="nav-item" data-section="editor">👤 Editor</div>
    <div class="sidebar-bottom">
      <button class="btn-logout" id="logoutBtn">Sign Out</button>
    </div>
  </div>

  <!-- MAIN -->
  <div class="main">

    <!-- VILLA SECTION -->
    <div class="section active" id="section-villa">
      <div class="page-title">Villa Info</div>
      <div class="page-subtitle">Update your villa details shown on the public website.</div>
      <div class="card">
        <h3>Beachfront Villa</h3>
        <div class="success-msg" id="villaSaved">✓ Villa info updated successfully!</div>
        <div class="form-group">
          <label>Villa Name</label>
          <input type="text" id="villaName" placeholder="Beachfront Villa" />
        </div>
        <div class="form-group">
          <label>Price per Night (₱)</label>
          <input type="number" id="villaPrice" placeholder="5000" />
        </div>
        <div class="form-group">
          <label>Description</label>
          <textarea id="villaDesc" placeholder="Describe the villa..."></textarea>
        </div>
        <button class="btn-save" id="saveVilla">Save Changes</button>
      </div>
    </div>

    <!-- GALLERY SECTION -->
    <div class="section" id="section-gallery">
      <div class="page-title">Gallery</div>
      <div class="page-subtitle">Add or remove photos from the public gallery.</div>
      <div class="card">
        <h3>Current Photos</h3>
        <div id="galleryGrid">
          <p style="color:#6b7280; font-size:14px;">No photos yet.</p>
        </div>
        <div class="form-group">
          <label>Category</label>
          <select id="photoCategory">
            <option value="beach">Beach</option>
            <option value="villa">Villa & Room</option>
            <option value="pool">Pool Area</option>
            <option value="grounds">Resort Grounds</option>
            <option value="events">Event Area</option>
          </select>
        </div>
        <div class="upload-area" id="uploadArea">
          <div style="font-size:32px;">📷</div>
          <p>Click to upload a photo</p>
          <input type="file" id="photoUpload" accept="image/*" style="display:none" />
        </div>
      </div>
    </div>

    <!-- EDITOR SECTION -->
    <div class="section" id="section-editor">
      <div class="page-title">Editor Management</div>
      <div class="page-subtitle">Add or remove the editor account.</div>
      <div class="card">
        <h3>Editor Account</h3>
        <div class="editor-status" id="editorStatus">No editor assigned yet.</div>
        <div class="success-msg" id="editorSaved">✓ Editor added successfully!</div>
        <div class="success-msg" id="editorRemoved" style="background:#fef2f2; border-color:#fecaca; color:#dc2626;">
          ✓ Editor removed successfully!
        </div>

        <!-- ADD FORM -->
        <div id="addEditorForm">
          <div class="form-group">
            <label>Editor Email</label>
            <input type="email" id="editorEmail" placeholder="editor@lcabana.com" />
          </div>
          <div class="form-group">
            <label>Editor Password</label>
            <input type="password" id="editorPassword" placeholder="Set a password for editor" />
          </div>
          <button class="btn-save" id="addEditor">Add Editor</button>
        </div>

        <!-- REMOVE FORM -->
        <div id="removeEditorForm" style="display:none;">
          <button class="btn-danger" id="removeEditor">Remove Editor</button>
        </div>

      </div>
    </div>

  </div>

  <script type="module">
    import { createClient } from 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm';

    const supabaseUrl = 'https://nrvoscraeeeeheeoxrgp.supabase.co';
    const supabaseKey = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5ydm9zY3JhZWVlZWhlZW94cmdwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzc3MjYyNTksImV4cCI6MjA5MzMwMjI1OX0.ngNxR0TQPqouL-cOHfamqGzMIVvtCqNjTe9GYDLXAzA';

    const supabase = createClient(supabaseUrl, supabaseKey);

   // ── CHECK SESSION ──
const { data: { session } } = await supabase.auth.getSession();
if (!session) {
  window.location.href = '/login';
}

// ── CHECK ROLE ──
const { data: profile } = await supabase
  .from('profiles')
  .select('role')
  .eq('email', session.user.email)
  .single();

// hide editor tab if not owner
if (profile?.role !== 'owner') {
  document.querySelector('[data-section="editor"]').style.display = 'none';
}

    // ── SIDEBAR NAVIGATION ──
    document.querySelectorAll('.nav-item').forEach(item => {
      item.addEventListener('click', () => {
        document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
        document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
        item.classList.add('active');
        document.getElementById('section-' + item.dataset.section).classList.add('active');
      });
    });

    // ── LOGOUT ──
    document.getElementById('logoutBtn').addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = '/login';
    });

    // ── LOAD VILLA INFO ──
    const { data: villa } = await supabase.from('villa').select('*').single();
    if (villa) {
      document.getElementById('villaName').value = villa.name || '';
      document.getElementById('villaPrice').value = villa.price || '';
      document.getElementById('villaDesc').value = villa.description || '';
    }

    // ── SAVE VILLA INFO ──
    document.getElementById('saveVilla').addEventListener('click', async () => {
      const name = document.getElementById('villaName').value;
      const price = document.getElementById('villaPrice').value;
      const description = document.getElementById('villaDesc').value;

      const { data: villaData } = await supabase.from('villa').select('*').single();

      if (villaData) {
        await supabase.from('villa').update({ name, price, description }).eq('name', villaData.name);
      } else {
        await supabase.from('villa').insert({ name, price, description });
      }

      document.getElementById('villaSaved').style.display = 'block';
      setTimeout(() => { document.getElementById('villaSaved').style.display = 'none'; }, 3000);
    });

    // ── LOAD GALLERY ──
    async function loadGallery() {
      const { data } = await supabase.from('gallery').select('*');
      const grid = document.getElementById('galleryGrid');

      if (!data || data.length === 0) {
        grid.innerHTML = '<p style="color:#6b7280; font-size:14px;">No photos yet.</p>';
        return;
      }

      grid.innerHTML = data.map(photo => `
        <div class="gallery-thumb">
          <img src="${photo.url}" alt="${photo.caption || ''}">
          <button class="gallery-thumb-delete" onclick="deletePhoto('${photo.id}', '${photo.url}')">✕</button>
        </div>
      `).join('');
    }

    loadGallery();

    // ── UPLOAD AREA ──
    document.getElementById('uploadArea').addEventListener('click', () => {
      document.getElementById('photoUpload').click();
    });

    // ── HANDLE PHOTO UPLOAD ──
    document.getElementById('photoUpload').addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;

      if (!file.type.startsWith('image/')) { alert('Only image files are allowed!'); return; }
      if (file.size > 5 * 1024 * 1024) { alert('File size must not exceed 5MB!'); return; }

      const fileName = `${Date.now()}_${file.name}`;

      const { error: uploadError } = await supabase.storage.from('gallery').upload(fileName, file);
      if (uploadError) { alert('Upload failed: ' + uploadError.message); return; }

      const { data: urlData } = supabase.storage.from('gallery').getPublicUrl(fileName);

      const { error: dbError } = await supabase.from('gallery').insert({
        url: urlData.publicUrl,
        caption: file.name,
        category: document.getElementById('photoCategory').value
      });

      if (!dbError) loadGallery();
    });

    // ── DELETE PHOTO ──
    window.deletePhoto = async (id, url) => {
      if (!confirm('Delete this photo?')) return;
      const fileName = url.split('/').pop();
      await supabase.storage.from('gallery').remove([fileName]);
      await supabase.from('gallery').delete().eq('id', id);
      loadGallery();
    };

    // ── LOAD EDITOR ──
    async function loadEditor() {
      const { data: editors } = await supabase.from('profiles').select('*').eq('role', 'editor');

      if (editors && editors.length > 0) {
        document.getElementById('editorStatus').innerHTML = `Current editor: <span>${editors[0].email}</span>`;
        document.getElementById('addEditorForm').style.display = 'none';
        document.getElementById('removeEditorForm').style.display = 'block';
      } else {
        document.getElementById('editorStatus').innerHTML = 'No editor assigned yet.';
        document.getElementById('addEditorForm').style.display = 'block';
        document.getElementById('removeEditorForm').style.display = 'none';
      }
    }

    loadEditor();

    // ── ADD EDITOR ──
document.getElementById('addEditor').addEventListener('click', async () => {
  const email = document.getElementById('editorEmail').value;
  const password = document.getElementById('editorPassword').value;

  if (!email || !password) { alert('Please enter both email and password!'); return; }
  if (password.length < 6) { alert('Password must be at least 6 characters!'); return; }

  const { data: existing } = await supabase.from('profiles').select('*').eq('role', 'editor');
  if (existing && existing.length > 0) { alert('An editor already exists! Remove the current editor first.'); return; }

  // create auth account
  const { data: signUpData, error: signUpError } = await supabase.auth.signUp({
    email,
    password
  });

  if (signUpError) {
    alert('Error creating account: ' + signUpError.message);
    return;
  }

  // save to profiles table
  const { error: profileError } = await supabase.from('profiles').insert({ email, role: 'editor' });

  if (!profileError) {
    document.getElementById('editorSaved').style.display = 'block';
    document.getElementById('editorEmail').value = '';
    document.getElementById('editorPassword').value = '';
    setTimeout(() => { document.getElementById('editorSaved').style.display = 'none'; }, 3000);
    loadEditor();
  }
});

    // ── REMOVE EDITOR ──
document.getElementById('removeEditor').addEventListener('click', async () => {
  if (!confirm('Are you sure you want to remove the editor?')) return;

  // get current editor email
  const { data: editors } = await supabase.from('profiles').select('*').eq('role', 'editor');
  const editorEmail = editors[0].email;

  // delete from auth via API route
 await fetch('/api/remove-editor', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ email: editorEmail })
  });

  // delete from profiles table
  const { error } = await supabase.from('profiles').delete().eq('role', 'editor');

  if (!error) {
    document.getElementById('editorRemoved').style.display = 'block';
    setTimeout(() => { document.getElementById('editorRemoved').style.display = 'none'; }, 3000);
    loadEditor();
  }
});

  </script>

</body>
</html>