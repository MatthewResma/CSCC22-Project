<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset Password | Lcabana Resort</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'DM Sans', sans-serif;
      background: #f5efe6;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .box {
      background: white;
      padding: 52px 48px;
      border-radius: 6px;
      width: 100%;
      max-width: 420px;
      box-shadow: 0 8px 40px rgba(0,0,0,0.08);
    }

    .logo {
      font-family: 'Cormorant Garamond', serif;
      font-size: 32px;
      font-weight: 600;
      color: #003049;
      letter-spacing: 2px;
      text-align: center;
      margin-bottom: 8px;
    }

    .subtitle {
      text-align: center;
      font-size: 13px;
      color: #6b7280;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 40px;
    }

    .form-group { margin-bottom: 20px; }

    .form-group label {
      display: block;
      font-size: 11px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #6b7280;
      margin-bottom: 8px;
    }

    .form-group input {
      width: 100%;
      padding: 14px 16px;
      border: 1px solid #e0e0e0;
      border-radius: 2px;
      font-family: 'DM Sans', sans-serif;
      font-size: 14px;
      color: #1a1a2e;
      outline: none;
      transition: border-color 0.3s;
    }

    .form-group input:focus { border-color: #c9a84c; }

    .btn {
      width: 100%;
      padding: 15px;
      background: #003049;
      color: white;
      border: none;
      font-family: 'DM Sans', sans-serif;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 2px;
      text-transform: uppercase;
      border-radius: 2px;
      cursor: pointer;
      transition: background 0.3s;
    }

    .btn:hover { background: #0077b6; }

    .success-msg {
      display: none;
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      color: #166534;
      padding: 12px 16px;
      border-radius: 2px;
      font-size: 13px;
      margin-bottom: 20px;
      text-align: center;
    }

    .error-msg {
      display: none;
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #dc2626;
      padding: 12px 16px;
      border-radius: 2px;
      font-size: 13px;
      margin-bottom: 20px;
      text-align: center;
    }

    .back-link {
      display: block;
      text-align: center;
      margin-top: 24px;
      font-size: 13px;
      color: #6b7280;
      text-decoration: none;
      transition: color 0.3s;
    }

    .back-link:hover { color: #003049; }
  </style>
</head>
<body>
  <div class="box">
    <div class="logo">Lcabana</div>
    <div class="subtitle">Reset Password</div>

    <div class="success-msg" id="successMsg">
      ✓ Password updated! Redirecting to login...
    </div>
    <div class="error-msg" id="errorMsg">
      Something went wrong. Please try again.
    </div>

    <div id="resetForm">
      <div class="form-group">
        <label>New Password</label>
        <input type="password" id="newPassword" placeholder="Enter new password" />
      </div>
      <div class="form-group">
        <label>Confirm Password</label>
        <input type="password" id="confirmPassword" placeholder="Confirm new password" />
      </div>
      <button class="btn" id="resetBtn">Update Password</button>
    </div>

    <a href="/login" class="back-link">← Back to Login</a>
  </div>

  <script type="module">
    import { createClient } from 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm';

    const supabaseUrl = 'https://nrvoscraeeeeheeoxrgp.supabase.co';
    const supabaseKey = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5ydm9zY3JhZWVlZWhlZW94cmdwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzc3MjYyNTksImV4cCI6MjA5MzMwMjI1OX0.ngNxR0TQPqouL-cOHfamqGzMIVvtCqNjTe9GYDLXAzA';

    const supabase = createClient(supabaseUrl, supabaseKey);

    // ── GET TOKEN FROM URL ──
    const hash = window.location.hash;
    const params = new URLSearchParams(hash.substring(1));
    const accessToken = params.get('access_token');
    const refreshToken = params.get('refresh_token');

    if (accessToken) {
      await supabase.auth.setSession({
        access_token: accessToken,
        refresh_token: refreshToken
      });
    }

    // ── RESET PASSWORD ──
    document.getElementById('resetBtn').addEventListener('click', async () => {
      const newPassword = document.getElementById('newPassword').value;
      const confirmPassword = document.getElementById('confirmPassword').value;
      const successMsg = document.getElementById('successMsg');
      const errorMsg = document.getElementById('errorMsg');

      if (!newPassword || !confirmPassword) {
        alert('Please fill in both fields!');
        return;
      }

      if (newPassword !== confirmPassword) {
        alert('Passwords do not match!');
        return;
      }

      if (newPassword.length < 6) {
        alert('Password must be at least 6 characters!');
        return;
      }

      const { error } = await supabase.auth.updateUser({
        password: newPassword
      });

      if (!error) {
        successMsg.style.display = 'block';
        document.getElementById('resetForm').style.display = 'none';
        setTimeout(() => {
          window.location.href = '/login';
        }, 2000);
      } else {
        errorMsg.style.display = 'block';
        errorMsg.textContent = error.message;
      }
    });
  </script>
</body>
</html>